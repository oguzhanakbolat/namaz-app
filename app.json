{
  "expo": {
    "name": "Namaz Vakti",
    "slug": "namaz-vakti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.oguzhan.namazvakti",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F2F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.oguzhan.namazvakti",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#011226",
          "android": {
            "image": "./assets/splash-blank.png",
            "imageWidth": 1,
            "backgroundColor": "#011226",
            "dark": {
              "image": "./assets/splash-blank.png",
              "backgroundColor": "#011226"
            }
          },
          "ios": {
            "image": "./assets/splash.jpg",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#011226",
            "dark": {
              "image": "./assets/splash.jpg",
              "backgroundColor": "#011226"
            }
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#0D7A9A",
          "sounds": ["./assets/sounds/vakit_cani.wav"]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "net.oguzhan.namazvakti.widgets",
          "groupIdentifier": "group.net.oguzhan.namazvakti",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "NextPrayer",
              "displayName": "Sıradaki Vakit",
              "description": "Sıradaki vakte kalan süre",
              "ios": {
                "supportedFamilies": ["systemSmall", "accessoryRectangular", "accessoryInline"],
                "initialLayout": "./src/widgets/ios/NextPrayer.tsx"
              }
            },
            {
              "name": "NextPrayerMini",
              "displayName": "Sıradaki Vakit (Mini)",
              "description": "Şeffaf: yalnızca sıradaki vakit ve saati",
              "ios": {
                "supportedFamilies": ["systemSmall", "accessoryCircular"],
                "initialLayout": "./src/widgets/ios/NextPrayerMini.tsx"
              }
            },
            {
              "name": "DailyTimes",
              "displayName": "Günün Vakitleri",
              "description": "Günün tüm vakitleri, şu anki vakit vurgulu",
              "ios": {
                "supportedFamilies": ["systemSmall"],
                "initialLayout": "./src/widgets/ios/DailyTimes.tsx"
              }
            },
            {
              "name": "PrayerPanel",
              "displayName": "Vakit Paneli",
              "description": "Sıradaki vakit ve günün vakitleri",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "initialLayout": "./src/widgets/ios/PrayerPanel.tsx"
              }
            },
            {
              "name": "PrayerStrip",
              "displayName": "Vakit Şeridi",
              "description": "Tüm vakitler tek satırda, şu anki vakit vurgulu",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "initialLayout": "./src/widgets/ios/PrayerStrip.tsx"
              }
            }
          ]
        }
      ]
    ],
    "scheme": "namazvakti",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/005f2b8c-38ed-4503-a954-b0b7435bfb35"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "net.oguzhan.namazvakti.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.net.oguzhan.namazvakti"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "005f2b8c-38ed-4503-a954-b0b7435bfb35"
      }
    },
    "owner": "oguzhan"
  }
}
