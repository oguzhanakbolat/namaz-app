<?xml version="1.0" encoding="utf-8"?>
<!-- Vakit Şeridi (4x1): üstte tek satırda konum + hicri tarih ve "Öğleye 1:22:41" (sağa yaslı),
     altta altı vakit kutucuklarda. Yükseklik artarsa kutucuklar büyür. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/nw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/nw_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:src="@drawable/nw_round_20"
    android:importantForAccessibility="no" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="true"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/nw_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Namaz Vakti"
        android:textColor="#1C2421"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/nw_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:textColor="#6B736F"
        android:textSize="11sp" />

      <LinearLayout
        android:id="@+id/nw_next_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:visibility="gone">

        <TextView
          android:id="@+id/nw_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:paddingEnd="5dp"
          android:textColor="#6B736F"
          android:textSize="12sp" />

        <Chronometer
          android:id="@+id/nw_timer"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="#0F6B5C"
          android:textSize="19sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

    <!-- wrap_content + weight: kutucuklar kalan yüksekliği doldurur, alan darsa doğal boylarına iner -->
    <LinearLayout
      android:id="@+id/nw_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="-2dp"
      android:layout_marginTop="5dp"
      android:layout_marginEnd="-2dp"
      android:orientation="horizontal" />
  </LinearLayout>
</FrameLayout>
