<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.akbolat.namazwidgets" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <receiver
            android:name="net.akbolat.namazwidgets.NextPrayerWidget"
            android:exported="false"
            android:label="@string/nw_name_next" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nw_next_prayer_info" />
        </receiver>
        <receiver
            android:name="net.akbolat.namazwidgets.NextPrayerMiniWidget"
            android:exported="false"
            android:label="@string/nw_name_mini" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nw_next_prayer_mini_info" />
        </receiver>
        <receiver
            android:name="net.akbolat.namazwidgets.DailyTimesWidget"
            android:exported="false"
            android:label="@string/nw_name_daily" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nw_daily_times_info" />
        </receiver>
        <receiver
            android:name="net.akbolat.namazwidgets.PrayerPanelWidget"
            android:exported="false"
            android:label="@string/nw_name_panel" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nw_prayer_panel_info" />
        </receiver>
        <receiver
            android:name="net.akbolat.namazwidgets.PrayerStripWidget"
            android:exported="false"
            android:label="@string/nw_name_strip" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nw_prayer_strip_info" />
        </receiver>
        <receiver
            android:name="net.akbolat.namazwidgets.PrayerCardWidget"
            android:exported="false"
            android:label="@string/nw_name_card" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nw_prayer_card_info" />
        </receiver>
        <receiver
            android:name="net.akbolat.namazwidgets.WidgetUpdateReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="net.akbolat.namazwidgets.TICK" />
                <action android:name="net.akbolat.namazwidgets.MINUTE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>